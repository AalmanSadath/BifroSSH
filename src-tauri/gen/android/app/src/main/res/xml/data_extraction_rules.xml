<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes to Google's cloud backup or to a device-to-device transfer.
     keystore.json would be useless there anyway: the fingerprint and PIN
     keys it refers to stay in this phone's hardware. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
