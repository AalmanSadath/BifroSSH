{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the windows terminal tabs are moved into",
  "windows": ["main", "term-*"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "opener:default"
  ]
}
